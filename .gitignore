# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Environment variables & secrets ─────────────────────────────
.env
.env.local
.env.development.local
.env.production.local
.env*.local
.env*
# keep a committed template if you add one
!.env.example
*.pem
*.key

# ── Dependencies ────────────────────────────────────────────────
/node_modules
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js & build outputs ─────────────────────────────────────
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# ── Pagefind search index (generated by `postbuild`) ────────────
/public/_pagefind/

# ── Deployment ──────────────────────────────────────────────────
.vercel

# ── Testing ─────────────────────────────────────────────────────
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# ── Local AI / agent configs & caches ───────────────────────────
.claude/
.impeccable/
.superpowers/
.mcp.json

# ── OS & editor metadata ────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ── Logs & local databases ──────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.db
*.sqlite
*.sqlite3
