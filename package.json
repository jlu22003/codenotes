{
  "name": "codenotes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind",
    "test:e2e": "playwright test",
    "test:e2e:functional": "playwright test --grep @functional",
    "test:e2e:a11y": "playwright test --grep @a11y",
    "test:e2e:visual": "sh e2e/docker.sh --grep @visual",
    "test:e2e:docker": "sh e2e/docker.sh",
    "test:e2e:update": "sh e2e/docker.sh --project=chromium --grep @visual --update-snapshots=all",
    "test:e2e:serve": "sh e2e/serve.sh",
    "test:e2e:links": "playwright test -c playwright.external.config.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "embla-carousel-wheel-gestures": "^8.1.0",
    "gsap": "^3.14.2",
    "lucide-react": "^0.562.0",
    "next": "15.5.9",
    "nextra": "^4.4.0",
    "nextra-theme-docs": "^4.4.0",
    "react": "^19.2.3",
    "react-dom": "^19.1.0",
    "react-photo-album": "^3.1.0",
    "resend": "^6.6.0",
    "tailwind-merge": "^3.4.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.0",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.0",
    "pagefind": "^1.3.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
